# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (lead persistence + durable voice dispatch queue)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Image generation / inpainting for /api/visualize and /api/visualize-countertop
# Provider: "gemini" or "replicate" (mock fallback used if keys missing)
VISUALIZER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# AI Chat (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retell AI (instant outbound + inbound receptionist, speed-to-lead)
RETELL_API_KEY=
# Live agent IDs (can be overridden via env; defaults wired in code/docs)
RETELL_OUTBOUND_AGENT_ID=agent_fcb2b96cc604fc946c3fce6b25
RETELL_INBOUND_AGENT_ID=agent_6444f3ed0ff36c841eb571d5e5
RETELL_FROM_NUMBER=+1XXXXXXXXXX

# GoHighLevel (GHL) CRM, calendar, workflows
# Provide either GHL_API_KEY (Contacts/Notes/Tags APIs) and/or GHL_WEBHOOK_URL (inbound webhook/workflow trigger)
GHL_API_KEY=
GHL_WEBHOOK_URL=
# Workflow B — "SOI - 02 Retell Post-Call Sync" (dedicated GHL webhook for Retell post-call analysis)
GHL_RETELL_WEBHOOK_URL=
# Alternate name for Workflow B webhook (used if GHL_RETELL_WEBHOOK_URL is not set)
GHL_WEBHOOK_URL_B=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_NURTURE_WORKFLOW_ID=

# Legacy/alternative voice providers (optional fallback if not using Retell outbound)
VOICE_PROVIDER=retell
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
SYNTHFLOW_API_KEY=
SYNTHFLOW_ASSISTANT_ID=
BLAND_API_KEY=
BLAND_PATHWAY_ID=

# Cron/job security (protect /api/jobs/dispatch-voice)
CRON_SECRET=
